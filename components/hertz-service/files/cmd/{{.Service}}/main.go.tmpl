package main

import (
	"os"

	"{{.CommonModule}}/config"
	"{{.CommonModule}}/hertzx"
	"{{.CommonModule}}/zlog"

	"{{.Module}}/app"
	"{{.Module}}/router"
)

func main() {
	// 1. Configuration: conf/<APP_ENV>.yaml, found via $CONF_DIR, ./conf, or next
	//    to the executable, so the start directory does not matter.
	//
	//    A start-up problem is reported through the logger and ends the process
	//    with status 1. Before hertzx.New the logger is configured by the
	//    environment (the Dockerfile sets ZLOG_FORMAT=json): this is the one line
	//    a log collector must not fail to parse. zlog.Fatal is called where the
	//    problem is, so the record names the step that failed.
	var cfg app.Config
	if err := config.LoadDefault(&cfg); err != nil {
		zlog.Fatal("cannot start", zlog.Err(err))
	}

	// 2. Framework: logging, the listener, the request log with a trace_id,
	//    recovery from panics, and the checks on Nacos.
	h, err := hertzx.New(cfg.Config)
	if err != nil {
		zlog.Fatal("cannot start", zlog.Err(err))
	}

	// 3. Service: the clients of the RPC services it calls, its middleware and
	//    its cleanup (app/app.go), then the routes generated from the IDL.
	if err := app.Setup(&cfg, h); err != nil {
		zlog.Fatal("cannot start", zlog.Err(err))
	}
	router.GeneratedRegister(h)

	// 4. Serve until SIGINT/SIGTERM, then stop gracefully: leave Nacos, keep
	//    serving briefly, finish requests in progress, run the cleanup.
	if err := hertzx.Run(h, cfg.Config); err != nil {
		os.Exit(1)
	}
}
