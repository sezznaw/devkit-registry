# =============================================================================
# {{.Service}} - DEV configuration
#
# Loaded when APP_ENV=dev: the shared development server, where everybody's
# services run together. Not your own machine, that is conf/local.yaml. Every
# setting is explained in conf/local.yaml and conf/README.md; this file only
# notes what differs on a server.
#
# ${NAME} is replaced by the environment variable NAME before parsing. Addresses
# and secrets come from the deployment platform, not from this file.
#
# This file is yours: devkit creates it once and never rewrites it.
# -----------------------------------------------------------------------------
# {{.Service}} - 开发服务器配置
#
# 当 APP_ENV=dev 时加载：公共的开发服务器，所有人的服务都部署在一起的地方。
# 它不是你自己的电脑，那是 conf/local.yaml。每个配置项的含义见 conf/local.yaml 和
# conf/README.zh-CN.md；这里只说明服务器环境的不同之处。
#
# ${NAME} 会在解析前被替换成环境变量 NAME 的值。地址和密码由部署平台注入，
# 不写在本文件里。
#
# 本文件归你所有：devkit 只创建一次，之后不会改写。
# =============================================================================

service:
  # Must match the name callers use.
  #
  # 必须与调用方使用的名字一致。
  name: {{.Service}}

  # Port to listen on (all interfaces). It must match the container port and
  # EXPOSE in the Dockerfile.
  #
  # 监听的端口（所有网卡）。必须与容器端口以及 Dockerfile 里的 EXPOSE 一致。
  addr: {{.Port}}

  # The address callers reach this instance at, "host" or "host:port", when it is
  # not the one the process sees: a container that is reached through the host's
  # address and a mapped port. The deployment sets ADVERTISE_ADDR then. Empty
  # (the variable not set): the address this machine reaches Nacos from, and the
  # port above, which is right when callers reach the container directly.
  #
  # 调用方访问本实例用的地址，"主机" 或 "主机:端口"。只有当它和进程自己看到的地址不一样
  # 时才需要：比如容器要通过宿主机地址加映射端口才能访问，这时由部署平台设置
  # ADVERTISE_ADDR。留空（不设置该变量）时，注册的是“本机连向 Nacos 时使用的地址”加上面
  # 的端口；调用方能直接访问容器时，这就是对的。
  advertise: "${ADVERTISE_ADDR}"

# Deployed services register, so that callers can find them.
#
# 部署到服务器上的服务要注册到 Nacos，调用方才能发现本服务。
registry_disabled: false

nacos:
  # Required. One "host:port"; for a cluster write several entries, e.g.
  #   addrs: ["${NACOS_ADDR_1}", "${NACOS_ADDR_2}"]
  #
  # 必填。一个 "主机:端口"；集群可写多个，例如上面这样。
  addrs: ["${NACOS_ADDR}"]

  # The namespace ID of the development environment. When dev and uat share one
  # Nacos server, the namespace is what keeps them apart: a service only sees
  # the services of its own namespace.
  #
  # 开发环境的命名空间 ID。dev 和 uat 共用一台 Nacos 时，靠命名空间把它们隔开：
  # 服务只能发现同一命名空间里的其他服务。
  namespace: "${NACOS_NAMESPACE}"

  group: DEFAULT_GROUP

  # Leave both variables unset when Nacos authentication is off.
  #
  # Nacos 未开启鉴权时，这两个环境变量不设置即可。
  username: "${NACOS_USERNAME}"
  password: "${NACOS_PASSWORD}"

log:
  # debug on the development server: that is what it is for.
  #
  # 开发服务器上用 debug：它就是用来排查问题的。
  level: debug

  # JSON, one object per line, for the log collector. Every record carries
  # service, env, host and version, and the trace_id of the request.
  #
  # JSON 格式，每行一个对象，供日志采集系统使用。每条日志都带有 service、env、
  # host、version，以及请求的 trace_id。
  format: json

  # Longer messages and field values are cut. Container runtimes split lines of
  # more than 16 KB, after which the collector no longer sees one JSON object.
  #
  # 超过这个长度的消息和字段值会被截断。容器运行时会把超过 16KB 的行拆开，
  # 拆开后采集系统看到的就不再是一个完整的 JSON 对象。
  max_field_bytes: 8192

  # Protection against a flood of one and the same record: within a second the
  # first 100 are written, after that every 100th. How many were left out is
  # reported once a second: "zlog: records dropped by sampling".
  #
  # 日志洪峰保护：同一条日志一秒内先写前 100 条，之后每 100 条写 1 条。丢了多少条，
  # 每秒会有一条汇总记录：zlog: records dropped by sampling。
  sampling:
    first: 100
    thereafter: 100

  # Optional, off on purpose: collect output in memory and write it in larger
  # pieces. It saves 1 to 2 microseconds per record, which only matters from
  # tens of thousands of records a second. The price: when the process dies
  # abnormally (out of memory, kill -9, an unrecovered panic) the records still
  # in memory are lost, and those are the ones that say what it was doing.
  # A normal stop loses nothing. Turn it on only when a CPU profile shows log
  # writing as a real cost; conf/README.md has the numbers.
  #
  # 可选，有意保持关闭：先在内存里攒一批再写出。每条日志能省 1 到 2 微秒，只有每秒几万条
  # 以上才有意义。代价：进程异常死亡（内存超限、kill -9、未捕获的 panic）时，还在内存里的
  # 日志会丢失，而那几条恰恰能说明它死之前在做什么。正常退出不会丢。只有当 CPU 性能分析
  # 显示写日志确实是一项开销时才打开；具体数字见 conf/README.zh-CN.md。
  # buffer:
  #   size: 262144
  #   flush_interval: 200ms   # at most this much can be lost / 最多丢失这么久的日志

# Optional: the Nacos configuration (data id) that kitexx.WatchConfig reads and
# follows while the service runs. Default: "<service.name>.yaml". Only used when
# app/app.go calls WatchConfig; see "Configuration that follows Nacos" in
# conf/README.md.
#
# 可选：kitexx.WatchConfig 读取并在运行中跟随的 Nacos 配置（data id）。
# 默认 "<service.name>.yaml"。只有 app/app.go 里调用了 WatchConfig 才会用到；
# 见 conf/README.zh-CN.md 的“跟随 Nacos 的配置”一节。
# config_data_id: {{.Service}}.yaml

# Optional: a Nacos configuration (data id) whose content is a log level. The
# running service follows it, which is how debug logging is switched on in
# production without a restart. The content is one word: debug, info, warn, error.
#
# 可选：一个 Nacos 配置（data id），内容是一个日志级别。运行中的服务会跟随它变化，
# 这样生产环境不用重启就能临时打开 debug 日志。内容只有一个词：debug、info、warn、error。
# log_level_data_id: {{.Service}}.log-level

# Graceful stop (the steps are described in conf/local.yaml).
#
# 优雅退出（各步骤的说明见 conf/local.yaml）。
shutdown:
  # How long to keep serving after leaving Nacos. Callers cache the instance list
  # and Nacos needs a moment to push the change; without this wait every rolling
  # deploy produces a short burst of connection errors on the caller side.
  #
  # 从 Nacos 注销后继续服务多久。调用方会缓存实例列表，Nacos 推送变更也需要时间；
  # 没有这段等待，每次滚动发布调用方都会出现一小段连接错误。
  deregister_wait: 3s

  # How long requests already in progress get to finish. Set it above your
  # slowest normal request.
  #
  # 已经在处理中的请求最多还能执行多久。应大于你最慢的正常请求耗时。
  drain_timeout: 15s

  # IMPORTANT: deregister_wait + drain_timeout must stay below the time the
  # platform waits before killing the process (Kubernetes
  # terminationGracePeriodSeconds, 30s by default). Otherwise the process is
  # killed in the middle of the graceful stop.
  #
  # 重要：deregister_wait + drain_timeout 必须小于部署平台强制杀进程前的等待时间
  # （Kubernetes 的 terminationGracePeriodSeconds，默认 30 秒）。
  # 否则进程会在优雅退出的中途被强杀。

# Tracing (OpenTelemetry): the OTLP gRPC collector spans are sent to, such as
# Tempo on port 4317. Empty switches tracing off. The deployment sets the
# address; every request then shows up in Grafana as a trace, and the
# trace_id in the log is the id of that trace.
#
# 链路追踪（OpenTelemetry）：span 发往的 OTLP gRPC 采集端，比如 Tempo 的 4317 端口。
# 留空即关闭。地址由部署平台注入；开启后每个请求在 Grafana 里都是一条 trace，
# 日志里的 trace_id 就是这条 trace 的 id。
otel:
  endpoint: "${OTEL_EXPORTER_OTLP_ENDPOINT}"
  # Share of new traces that are recorded, 0 to 1; a decision a caller made
  # is kept. 1 in dev; lower it in production when the collector cannot keep up.
  #
  # 新 trace 的采样比例，0 到 1；调用方已经决定的沿用其决定。dev 用 1，生产按采集端压力调低。
  sample_ratio: 1.0

# MySQL. Every service has this section; most leave it off. On, the framework
# connects before the service registers (no database, no start) and hands the
# handle to repo/ as rt.DB. In a deployment the address is not written here:
# source platform looks the database of the tenant this deployment serves
# (environment variable TENANT_CODE) up in the platform's datasource table;
# the platform database's own address is infra.yaml in Nacos, and every
# password is an environment variable the deployment sets.
#
# MySQL。每个服务都有这一段，大多数关着。打开后框架在服务注册之前连库（连不上就不启动），
# 并把句柄作为 rt.DB 交给 repo/。部署环境里不写地址：source platform 按本部署服务的租户
# （环境变量 TENANT_CODE）去平台库的 datasource 表查；平台库自己的地址在 Nacos 的 infra.yaml，
# 所有密码都是部署注入的环境变量。
mysql:
  enabled: false
  # source: platform
  # role: tenant            # tenant: this tenant's database; platform: the platform database itself
                            # tenant：本租户的库；platform：平台库本身
  # slow_query: 200ms       # slower than this is a warn record "mysql slow query"

# Redis / Valkey. Same rules as mysql: off by default; on, the framework connects
# before the service registers and hands the client to repo/ as rt.Redis.
# source platform: the tenant's valkey row of the platform's datasource table.
# A method whose request has a request_id field needs this (idempotency store).
#
# Redis / Valkey。规则和 mysql 一样：默认关；开了框架在注册前连上，句柄作为 rt.Redis
# 交给 repo/。source platform：平台 datasource 表里本租户 kind 为 valkey 的那一行。
# 请求带 request_id 字段的方法（幂等）需要它。
redis:
  enabled: false
  # source: platform
  # role: tenant

# Kafka (Redpanda), the event bus. Same rules: off by default; on, rt.Kafka
# publishes (Publish) and the handlers registered in app.Setup (Subscribe) run
# once the server is up. source platform: the tenant's kafka row of the
# datasource table.
#
# Kafka（Redpanda），事件总线。规则相同：默认关；开了 rt.Kafka 发事件（Publish），
# app.Setup 里注册的 Subscribe 在服务起来后开始消费。source platform：datasource 表里
# 本租户 kind 为 kafka 的那一行。
kafka:
  enabled: false
  # source: platform
  # role: tenant
  # max_retries: 3          # a failing handler is retried this often, then the message goes to <topic>.dlq
  # Outbox: an event written with PublishTx inside a database transaction is
  # published by a relay in this process (on by default with mysql.enabled).
  #
  # 事务里的事件（PublishTx）由本进程的转发器发出，有 MySQL 时默认开。
  # outbox:
  #   enabled: true
  #   poll_interval: 500ms
  #   batch: 100
  #   retention: 168h
  #   publish_timeout: 10s

# Centrifugo, push to clients. Off by default; on, rt.Centrifugo publishes to
# channels and signs connection tokens. source platform: address from
# infra.yaml in Nacos, secrets from the environment variables it names.
#
# Centrifugo，推送给客户端。默认关；开了 rt.Centrifugo 往频道推、给客户端签连接 token。
# source platform：地址来自 Nacos 的 infra.yaml，密钥来自它指名的环境变量。
centrifugo:
  enabled: false
  # source: platform

# Calls to other services (kitexx.ClientOptions): 3s per call, 1s to connect,
# one retry only when the request was never sent, a circuit breaker per
# service and method. The defaults suit the cluster; uncomment to change.
#
# 对其他服务的调用（kitexx.ClientOptions）：单次 3s、建连 1s、只在请求没发出去时重试 1 次、按服务和方法熔断。
# 默认值就是集群里该有的，要改再打开。
# rpc_client:
#   timeout: 3s
#   connect_timeout: 1s
#   retries: 1
#   breaker: true

# Object storage (SeaweedFS on dev, any S3 later), off by default; on, rt.S3
# stores and reads files under this service's prefix and signs download /
# upload URLs. source platform: the datasource row of kind s3 (endpoint,
# bucket, the variables holding the keys), injected by the deployment.
#
# 对象存储（dev 是 SeaweedFS，以后可换任何 S3），默认关；开了 rt.S3 在本服务前缀下存取文件、签下载/上传链接。
# source platform：数据源表 kind=s3 那行（地址、桶、密钥变量名），由部署注入。
s3:
  enabled: false
  # source: platform

# Login state (authx): this gateway verifies the access tokens of one realm
# locally plus one Redis read (redis.enabled is required), and protects every
# endpoint the IDL does not mark `// @public`. The secret is the one ser-auth
# signs with, from the environment.
#
# 登录态（authx）：本网关本地校验一个领域的 access 令牌，再读一次 Redis（需要 redis.enabled），
# 保护 IDL 里没标 `// @public` 的所有接口。secret 和 ser-auth 签发用的是同一个，来自环境变量。
auth:
  enabled: true
  secret: "${AUTH_JWT_SECRET}"
  realm: member                 # member | admin | agent：本网关服务哪类主体
  access_ttl: 15m
  refresh_ttl: 720h

# Prometheus metrics on a port of their own (default 9091), scraped by the
# deployment: requests by method and result code, latency, Go runtime, MySQL
# pool, Redis commands, Kafka events. Nothing to write in the service.
#
# Prometheus 指标，单独端口（默认 9091），由部署抓取：每个方法的请求数和结果码、耗时、Go 运行时、
# MySQL 连接池、Redis 命令、Kafka 事件。服务里不用写任何代码。
metrics:
  enabled: true
  addr: 9091

# External HTTP APIs this service calls (a sports data vendor, a payment
# gateway): rt.Provider("<name>") in app.Setup. Timeout per attempt (default
# 5s); retries (default 2) only for GET/HEAD/OPTIONS/PUT/DELETE on network
# errors, 429 and 5xx, a POST is never retried; secrets come from the
# environment. A service with providers is deployed to the -provider
# namespace (the only one that may leave the cluster); the framework checks.
#
# 本服务要调的外部 HTTP 接口（赛事数据源、支付通道）：app.Setup 里 rt.Provider("<名>")。单次超时默认 5s；
# 重试默认 2 次，只对 GET/HEAD/OPTIONS/PUT/DELETE 且只在网络错误、429、5xx 时，POST 绝不重试；密钥来自环境变量。
# 有 providers 的服务要部署到 -provider namespace（唯一能出网的），框架启动时会检查。
providers: {}
#  odds-feed:
#    base_url: "https://api.vendor.com"
#    timeout: 3s
#    retries: 2
#    headers:
#      X-Api-Key: "${ODDS_FEED_API_KEY}"
#    max_concurrent: 64        # calls in flight at once; the rest wait within their timeout
#    breaker_failures: 5       # consecutive failures that open the circuit (0 = off)
#    breaker_open_for: 30s     # fail fast for this long, then one probe
#    debug: false              # local only: log every request and response with bodies
#    auth:                     # bearer | basic | hmac-sha256 | oauth2 | custom (UseSigner in app.Setup)
#      type: oauth2
#      token_url: "https://id.vendor.com/token"
#      client_id: "${PAYMENT_X_CLIENT_ID}"
#      client_secret: "${PAYMENT_X_CLIENT_SECRET}"
#    callback:                 # the provider calling us; the route is webhookx.Handle in app.Setup (Hertz service)
#      verify: {type: hmac-sha256, secret: "${PAYMENT_X_CALLBACK_SECRET}", header: X-Signature, payload: "{timestamp}.{body}"}
#      allow_cidrs: ["203.0.113.0/24"]
#      event_id: {json: "data.id"}
# Secrets: one environment variable per secret, named <PROVIDER>_<FIELD>, filled by
# the operator in the deployment's provider-secrets Secret and injected automatically.
#
# 密钥：一个密钥一个环境变量，命名 <厂商>_<字段>，运维填进部署的 provider-secrets Secret，自动注入。

# API documentation: /docs (Scalar API Reference, "Send request" against this service) and
# /openapi.yaml, generated from the IDL by make gen. Off in production.
#
# 接口文档：/docs（Scalar 文档页，可直接试调）和 /openapi.yaml，make gen 从 IDL 生成。生产关。
docs:
  enabled: true

# CORS: which browser origins may call this service directly (a web front end on
# its own domain, a tester page). Off unless a page on another origin needs it;
# list the exact origins. A mobile app or a same-origin page needs nothing here.
#
# 跨域：允许哪些浏览器来源直接调用本服务（独立域名的前端、测试页）。默认关；要开就把来源写全
# （协议、域名、端口）。App 或同域名页面不需要。
cors:
  enabled: false
  allowed_origins: []
  # allowed_origins: ["https://tester.example.com"]
