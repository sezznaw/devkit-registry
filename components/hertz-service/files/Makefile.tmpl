# Generated by devkit (hertz-service@{{.ComponentVersion}}).
MODULE   := {{.Module}}
SERVICE  := {{.Service}}

# Thrift IDLs live in the project's shared IDL repository. Locally that is the
# idl/ directory next to this service; CI overrides IDL_DIR after cloning it.
IDL_DIR  ?= ../idl
# Which IDLs to generate is listed in idl.mk (yours to edit): API_IDL is this
# service's own HTTP API, IDLS are the RPC services it calls. Without that file
# only the service's own IDL is used.
-include idl.mk
API_IDL  ?= $(SERVICE)/$(SERVICE).thrift
IDLS     ?=

HZ_VERSION       := {{.HzVersion}}
SWAGGER_GEN_VERSION := {{.SwaggerGenVersion}}
KITEX_VERSION    := {{.KitexVersion}}
THRIFTGO_VERSION := {{.ThriftgoVersion}}
DEVKIT_VERSION   := {{.DevkitVersion}}

.PHONY: tools check-tools gen build run job jobs test lint docker clean

## tools: install the code generators (once per machine)
tools:
	go install github.com/cloudwego/hertz/cmd/hz@$(HZ_VERSION)
	go install github.com/cloudwego/kitex/tool/cmd/kitex@$(KITEX_VERSION)
	go install github.com/cloudwego/thriftgo@$(THRIFTGO_VERSION)
	go install github.com/hertz-contrib/swagger-generate/thrift-gen-http-swagger@$(SWAGGER_GEN_VERSION)

## check-tools: the generators must be the team's versions. Code generated by
## another version may not match the library, and everyone must get the same
## output from the same IDL.
check-tools:
	@have=$$(hz --version 2>&1 | tail -1 | awk '{print $$NF}'); \
	if [ "$${have#v}" != "$(HZ_VERSION:v%=%)" ]; then \
		echo "hz reports '$$have', this project uses $(HZ_VERSION). Run: make tools"; exit 1; fi
	@have=$$(kitex -version 2>&1 | tail -1); \
	if [ "$${have#v}" != "$(KITEX_VERSION:v%=%)" ]; then \
		echo "kitex reports '$$have', this project uses $(KITEX_VERSION). Run: make tools"; exit 1; fi
	@have=$$(thriftgo --version 2>&1 | tail -1 | awk '{print $$NF}'); \
	if [ "$${have#v}" != "$(THRIFTGO_VERSION:v%=%)" ]; then \
		echo "thriftgo reports '$$have', this project uses $(THRIFTGO_VERSION). Run: make tools"; exit 1; fi

## gen: generate the code that comes from the IDLs (run after every IDL change):
##   cmd/<service>/openapi.yaml  the API documentation (served at /docs with docs.enabled)
##   hertz_gen/ and router/   the structs and routes of this service's API (hz);
##                            a method that is new gets an empty function in
##                            handler/, existing ones are never touched
##   kitex_gen/               the clients of the RPC services listed in IDLS
## "template=slim" makes plain structs: an HTTP API speaks JSON and has no use
## for Thrift's binary codec, nor for the old apache/thrift library it needs.
gen: check-tools
	@echo ">> hz $(API_IDL)"
	@hz update -I $(IDL_DIR) -idl $(IDL_DIR)/$(API_IDL) -t template=slim
	@for f in $(IDLS); do \
		echo ">> kitex $$f"; \
		kitex -module $(MODULE) $(IDL_DIR)/$$f || exit 1; \
	done
	@echo ">> apidoc $(API_IDL) -> cmd/$(SERVICE)/openapi.yaml"
	@go run {{.CommonModule}}/cmd/apidoc -idl $(IDL_DIR)/$(API_IDL) -out cmd/$(SERVICE)/openapi.yaml \
		-version "$$(git describe --tags --always --dirty 2>/dev/null || echo dev)"

build:
	go build -o bin/$(SERVICE) ./cmd/$(SERVICE)

run:
	APP_ENV=$${APP_ENV:-local} go run ./cmd/$(SERVICE)

## job: run one scheduled job (app/jobs.go) once, here, against the local
## configuration: make job NAME=reconcile-bets
job:
	@test -n "$(NAME)" || { echo "usage: make job NAME=<job name>   (make jobs lists them)"; exit 1; }
	APP_ENV=$${APP_ENV:-local} go run ./cmd/$(SERVICE) --job=$(NAME)

## jobs: list the scheduled jobs as the deployment sees them
jobs:
	@go run ./cmd/$(SERVICE) --list-jobs

test:
	go test ./...

## lint: go vet, then devkit lint (the team's rules: see idl/AGENTS.md; a line opts out with //devkit:lint-ignore <rule>)
lint:
	go vet ./...
	go run github.com/sezznaw/devkit@$(DEVKIT_VERSION) lint --idl $(IDL_DIR)

docker:
	docker build -t $(SERVICE):$$(git rev-parse --short HEAD) .

clean:
	rm -rf bin output
