//	opts, err := kitexx.ClientOptions(cfg.Config) // finds "user" through Nacos
//	if err != nil {
//		return err
//	}
//	if deps.User, err = userservice.NewClient("user", opts...); err != nil {
//		return err
//	}
//
// In a handler, pass the ctx of the request on: deps.User.GetUser(ctx, req).
// It carries the trace_id to the RPC service.
//
// Setup 在启动时被调用一次：此时配置已加载、日志已就绪，服务尚未开始接收请求。
// 在这里创建路由需要的东西并放进 deps 包，用 h.Use 添加对所有路由生效的中间件，用 hertzx.OnShutdown
// 注册清理动作：它们会在服务从 Nacos 注销、最后一个处理中的请求结束之后，按相反顺序执行。
// 返回 error 会中止启动，并打印一条明确的错误信息。创建 RPC 客户端的写法见上面的示例
// （在 deps/deps.go 里声明，在这里创建）；在 handler 里调用 deps.User.GetUser(ctx, req)
// 时把请求的 ctx 原样传下去，trace_id 靠它传到 RPC 服务。
