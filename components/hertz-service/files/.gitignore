# generated by `make gen` from the IDL repository; never committed
hertz_gen/
kitex_gen/
router/**/*.go
# ...except the hooks for middleware, which are yours
!router/**/middleware.go
bin/
output/
*.test
.idl/
.go/
# generated by make gen from the IDL, embedded into the binary
cmd/*/openapi.yaml
# copy of idl.deps made by make gen (idl.deps itself is committed), embedded into the binary
cmd/*/idl.deps

# [takeover] written by devkit takeover while it runs; never committed
.devkit/takeover.json*
