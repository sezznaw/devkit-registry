// Package system implements the routes of the system domain (../idl/{{.Service}}/system.thrift).
//
// This file is yours. `make gen` (hz) adds an empty function here for every
// method that is new in the IDL and never changes the ones that exist. What a
// handler needs (the clients of the RPC services it calls) is created in
// app/app.go, kept in package deps and used as deps.User.GetUser(ctx, ...).
package system

import (
	"context"

	"github.com/cloudwego/hertz/pkg/app"

	"{{.CommonModule}}/hertzx"
	"{{.CommonModule}}/zlog"

	// Under the name of the package, not an alias: the functions hz adds to this
	// file for new methods refer to the structs as system.XxxReq.
	system "{{.Module}}/hertz_gen/system"
)

// Ping is the sample route from the initial IDL. Replace it with real ones:
// edit ../idl/{{.Service}}/system.thrift and run `make gen`. Another domain
// is another file there and another package here (handler/<domain>/).
// @router /ping [GET]
func Ping(ctx context.Context, c *app.RequestContext) {
	var req system.PingReq
	if !hertzx.Bind(c, &req) { // answers {code:1001, msg:"<field>: <rule>"} itself
		return
	}

	// zlog.Ctx(ctx) is the logger of this request: every record carries its
	// trace_id, method and path. Pass ctx on when you call an RPC service, and
	// the trace_id travels with the call.
	zlog.Ctx(ctx).Info("ping", zlog.Str("message", req.Message))

	// hertzx.OK adds the envelope: {code: 0, msg: "", data: {...}}. An RPC error
	// is hertzx.Fail(ctx, c, err) (its business code goes through, anything else
	// is logged and answered as 5001); a code the gateway decides itself is
	// hertzx.FailCode(c, code, msg). Never c.JSON here (lint rule envelope-write).
	hertzx.OK(c, &system.Pong{Message: "pong: " + req.Message})
}
