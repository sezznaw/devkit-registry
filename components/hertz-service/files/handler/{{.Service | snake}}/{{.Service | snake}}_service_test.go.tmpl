package {{.Service | snake}}

import (
	"strings"
	"testing"

	"github.com/cloudwego/hertz/pkg/app/server"

	"{{.CommonModule}}/testx"

	"{{.Module}}/router"
)

// The route test sample: the generated router on a bare server, called
// in-process with testx.Get / testx.Post (no network, no Nacos). A route that
// calls an RPC service needs its client in package deps; a test sets a fake
// there (deps.User = fakeUser{}) before calling the route.
//
// 路由测试样板：生成的路由挂在一个裸服务器上，用 testx.Get / testx.Post 进程内调（不走网络、
// 不连 Nacos）。调 RPC 服务的路由要先在 deps 包里放假客户端（deps.User = fakeUser{}）。
func TestPing(t *testing.T) {
	h := server.New(server.WithDisablePrintRoute(true))
	router.GeneratedRegister(h)
	r := testx.Get(t, h, "/ping?message=hi")
	if r.Status != 200 || !strings.Contains(r.Body, "pong") {
		t.Fatalf("ping: %s", r)
	}
}
