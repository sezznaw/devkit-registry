# =============================================================================
# {{.Service}} - LOCAL DEVELOPMENT configuration / 本地开发配置
#
# Loaded when APP_ENV is unset or "dev". The file name selects the environment:
# APP_ENV=test loads conf/test.yaml, APP_ENV=prod loads conf/prod.yaml.
# 当环境变量 APP_ENV 未设置或为 "dev" 时加载本文件。文件名决定环境：
# APP_ENV=test 加载 conf/test.yaml，APP_ENV=prod 加载 conf/prod.yaml。
#
# The conf directory is looked up in this order: $CONF_DIR, ./conf, next to the
# executable. So the service starts from any working directory.
# conf 目录的查找顺序：环境变量 CONF_DIR、当前目录下的 conf、可执行文件旁边。
# 因此从任何工作目录启动服务都可以。
#
# ${NAME} anywhere in this file is replaced by the environment variable NAME
# before the file is parsed. Use it for secrets; never commit real passwords.
# 文件中任何位置的 ${NAME} 都会在解析前被替换成环境变量 NAME 的值。
# 密码等敏感信息请用这种方式传入，不要把真实密码提交进仓库。
#
# This file is yours: devkit creates it once and never rewrites it. New settings
# introduced by later template versions are announced by `devkit update` and
# documented in conf/README.md.
# 本文件归你所有：devkit 只创建一次，之后不会改写。以后模板新增的配置项，
# `devkit update` 会在升级后提示，完整说明见 conf/README.md。
# =============================================================================

service:
  # Name under which the service registers in Nacos and appears in every log
  # line. Callers find the service by this name, so changing it breaks them.
  # 服务在 Nacos 中注册的名字，也会出现在每一行日志里。
  # 调用方靠这个名字找到本服务，修改它会导致调用方找不到。
  name: {{.Service}}

  # Port the RPC server listens on, on every network interface. When registering
  # in Nacos this machine's IPv4 address is filled in automatically. To listen
  # on one interface only, write "host:port" instead, e.g. "127.0.0.1:{{.Port}}".
  # RPC 服务监听的端口（监听所有网卡）。向 Nacos 注册时会自动填入本机的 IPv4 地址。
  # 只想监听某一块网卡时，改写成 "主机:端口"，例如 "127.0.0.1:{{.Port}}"。
  addr: {{.Port}}

# true  = run without Nacos. The service is not registered, still listens and
#         can be called directly by address; the services it calls are not
#         looked up (give their address with client.WithHostPorts); and a
#         configuration it reads from Nacos (kitexx.WatchConfig) is the file
#         conf/nacos/<data id> instead, where saving the file counts as a change.
#         Convenient on a laptop: no Nacos needed.
# false = register in Nacos on start and deregister on stop (see "nacos" below).
# true  = 不使用 Nacos。服务不注册，照常监听，可以通过地址直接调用；它要调用的服务
#         也不会被查找（用 client.WithHostPorts 指明地址）；它从 Nacos 读取的配置
#         （kitexx.WatchConfig）改为读取文件 conf/nacos/<data id>，保存文件就相当于
#         在控制台里改了配置。本机开发时很方便：不需要 Nacos。
# false = 启动时注册到 Nacos，退出时注销（连接参数见下面的 nacos 一节）。
registry_disabled: true

# Nacos connection, used for registration (when enabled above), for finding the
# services this one calls (kitexx.ClientOptions) and for configuration that
# follows Nacos while the service runs (kitexx.WatchConfig, see conf/README.md).
# Nacos 连接参数。用于注册本服务（上面开启时）、查找本服务要调用的其他服务，
# 以及读取运行中跟随 Nacos 变化的配置（kitexx.WatchConfig，见 conf/README.md）。
nacos:
  # Nacos servers as "host:port". List several for a cluster.
  # Nacos 服务器地址，格式 "主机:端口"。集群可以写多个。
  addrs: ["{{.NacosAddr}}"]

  # Namespace ID (not its display name). "" is the default "public" namespace.
  # Namespaces isolate environments: a service only sees services in its own.
  # 命名空间 ID（不是显示名称）。"" 表示默认的 public 命名空间。
  # 命名空间用于隔离环境：服务只能发现同一命名空间里的其他服务。
  namespace: ""

  # Group of the service and of its configurations. Callers must use the same
  # group. Default: DEFAULT_GROUP.
  # 服务及其配置所在的分组。调用方必须使用相同的分组。默认 DEFAULT_GROUP。
  group: DEFAULT_GROUP

  # Credentials, only needed when Nacos authentication is turned on.
  # 用户名和密码，仅在 Nacos 开启了鉴权时需要。
  # username: ""
  # password: "${NACOS_PASSWORD}"

  # The Nacos client logs through the logger of the service (logger=nacos-sdk),
  # from this level up: debug, info, warn, error. Default warn. At info it prints
  # the content of every configuration it receives, passwords included. While
  # Nacos is unreachable its many reconnect messages are replaced by three
  # records (connection lost, still unreachable, restored); debug shows them all.
  # Nacos 客户端的日志走本服务的日志系统（带 logger=nacos-sdk），从这个级别起输出：
  # debug、info、warn、error，默认 warn。设为 info 时它会打印收到的每一份配置的内容，
  # 包括密码。Nacos 连不上期间，它大量的重连日志会被三种记录代替（连接断开、仍未恢复、
  # 已恢复）；设为 debug 可以看到全部原始日志。
  # sdk_log_level: warn

  # Where the Nacos client keeps its cache of service lists.
  # Default: /tmp/nacos/cache.
  # Nacos 客户端缓存服务列表的目录。默认 /tmp/nacos/cache。
  # cache_dir: /tmp/nacos/cache

# The Nacos configuration (data id) that kitexx.WatchConfig reads and follows.
# Default: "<service.name>.yaml". Only used when app/app.go calls WatchConfig.
# kitexx.WatchConfig 读取并跟随的 Nacos 配置（data id）。默认 "<service.name>.yaml"。
# 只有 app/app.go 里调用了 WatchConfig 才会用到。
# config_data_id: {{.Service}}.yaml

log:
  # Minimum level that is written: debug, info, warn, error.
  # debug is verbose and meant for development.
  # 输出的最低日志级别：debug、info、warn、error。debug 很详细，适合开发阶段。
  level: debug

  # console = colored lines for people. In GoLand's Run window and in a terminal
  #           the file:line of every record is a link to that line.
  # json    = one JSON object per line (what log collectors expect in production).
  # Kitex's internal messages, and what dependencies print with the standard
  # log or log/slog packages, come out in the same format.
  # console = 给人看的彩色文本。在 GoLand 的 Run 窗口和终端里，每条日志的
  #           文件名:行号 都可以点击跳转。
  # json    = 每行一个 JSON 对象（生产环境的日志采集系统需要这种格式）。
  # Kitex 框架内部的日志，以及依赖库用标准库 log、log/slog 打的日志，都是同样的格式。
  format: console

  # Attach the call stack to records from this level up. On the console every
  # frame of the stack is a link. Remove the line for no stacks.
  # 从这个级别起，日志附带调用堆栈。控制台里堆栈的每一行都可以点击。删掉这行则不带堆栈。
  stacktrace: error

# Graceful stop, triggered by SIGINT (Ctrl+C) or SIGTERM. The order is:
#   1. deregister from Nacos
#   2. keep serving for deregister_wait, so callers notice and stop sending
#   3. close the listener, let requests in progress finish (up to drain_timeout)
#   4. run the kitexx.OnShutdown hooks (close database, Redis, ...)
# 优雅退出，由 SIGINT（Ctrl+C）或 SIGTERM 触发。顺序是：
#   1. 从 Nacos 注销
#   2. 继续服务 deregister_wait 这么久，让调用方察觉并停止发送请求
#   3. 关闭监听，等待处理中的请求完成（最多 drain_timeout）
#   4. 执行 kitexx.OnShutdown 注册的钩子（关闭数据库、Redis 等）
shutdown:
  # Durations are written like 500ms, 3s, 1m. 0s disables the wait.
  # Locally there is nobody to wait for, so stopping is immediate.
  # 时长的写法如 500ms、3s、1m。0s 表示不等待。本地开发没有调用方需要等，所以立即退出。
  deregister_wait: 0s
  drain_timeout: 5s
