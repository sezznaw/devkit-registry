{{- if or (eq .CI "gitlab") (eq .CI "both") -}}
# Generated by devkit (kitex-service@{{.ComponentVersion}}).
# kitex_gen/ is not committed: the pipeline clones the shared IDL project and
# regenerates it before building.
#
# The IDL project must allow this project's job token:
#   IDL project -> Settings -> CI/CD -> Job token permissions -> add this project.
stages: [build, test]

variables:
  # Path of the shared IDL project on this GitLab. Override it in
  # Settings -> CI/CD -> Variables if it lives somewhere else.
  IDL_PROJECT: "{{if .IdlRepo}}{{.IdlRepo}}{{else}}${CI_PROJECT_NAMESPACE}/idl{{end}}"
  IDL_DIR: "$CI_PROJECT_DIR/.idl"
  GOPATH: "$CI_PROJECT_DIR/.go"
{{- if .GoPrivate}}
  GOPRIVATE: "{{.GoPrivate}}"
{{- end}}

default:
  image: golang:{{.GoVersion}}
  cache:
    key: go-$CI_COMMIT_REF_SLUG
    paths: [.go/pkg/mod]
  before_script:
    - export PATH="$GOPATH/bin:$PATH"
{{- if .GoPrivate}}
    # Private Go modules on this GitLab are fetched with the job token.
    - git config --global url."https://gitlab-ci-token:${CI_JOB_TOKEN}@${CI_SERVER_HOST}/".insteadOf "https://${CI_SERVER_HOST}/"
{{- end}}
    - git clone --depth 1 "https://gitlab-ci-token:${CI_JOB_TOKEN}@${CI_SERVER_HOST}/${IDL_PROJECT}.git" "$IDL_DIR"
    - make tools
    - make gen
    - go mod tidy

build:
  stage: build
  script:
    - make build
  artifacts:
    paths: [bin/]
    expire_in: 1 day

test:
  stage: test
  script:
    - make lint
    - make test
{{- end}}
