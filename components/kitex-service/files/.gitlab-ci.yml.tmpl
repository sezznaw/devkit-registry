{{- if or (eq .CI "gitlab") (eq .CI "both") -}}
# Generated by devkit (kitex-service@{{.ComponentVersion}}).
# kitex_gen/ is not committed: the pipeline clones the shared IDL project and
# regenerates it before building.
#
# The IDL project must allow this project's job token:
#   IDL project -> Settings -> CI/CD -> Job token permissions -> add this project.
stages: [build, test]

variables:
  # Path of the shared IDL project on this GitLab. Override it in
  # Settings -> CI/CD -> Variables if it lives somewhere else.
  IDL_PROJECT: "{{if .IdlRepo}}{{.IdlRepo}}{{else}}${CI_PROJECT_NAMESPACE}/idl{{end}}"
  IDL_DIR: "$CI_PROJECT_DIR/.idl"
  GOPATH: "$CI_PROJECT_DIR/.go"
  GOCACHE: "$CI_PROJECT_DIR/.go-build"
{{- if .GoPrivate}}
  GOPRIVATE: "{{.GoPrivate}}"
{{- end}}

default:
  image: golang:{{.GoVersion}}
  # One cache per branch, seeded from the default branch's: downloaded modules,
  # the installed generators, and Go's build cache, so that a job compiles only
  # what changed and make tools is a no-op. The build job refreshes it; test
  # only reads it (policy: pull).
  cache:
    key: go-$CI_COMMIT_REF_SLUG
    fallback_keys: [go-$CI_DEFAULT_BRANCH]
    paths: [.go/pkg/mod, .go/bin, .go-build]
  before_script:
    - export PATH="$GOPATH/bin:$PATH"
    # Private Go modules on this GitLab (the project's lib/, for one) are fetched with the job
    # token: the netrc covers go's module discovery and the git clone, GOPRIVATE skips the proxy.
    - printf 'machine %s login gitlab-ci-token password %s\n' "$CI_SERVER_HOST" "$CI_JOB_TOKEN" > ~/.netrc && chmod 600 ~/.netrc
    - export GOPRIVATE="${GOPRIVATE:+$GOPRIVATE,}$CI_SERVER_HOST"
    - git clone --depth 1 "https://gitlab-ci-token:${CI_JOB_TOKEN}@${CI_SERVER_HOST}/${IDL_PROJECT}.git" "$IDL_DIR"
    # idl.lock (written by make gen) names the IDL commit this code was generated from; build against exactly it.
    - |
      if [ -f idl.lock ]; then
        SHA=$(cat idl.lock)
        if ! git -C "$IDL_DIR" fetch -q --depth 1 origin "$SHA" 2>/dev/null; then
          echo "idl.lock 指向的 IDL 提交 $SHA 不在服务器上：先推送 idl 仓库，再推本服务。"; exit 1
        fi
        git -C "$IDL_DIR" checkout -q "$SHA"
      fi
    - make tools
    - make gen
    - go mod tidy

build:
  stage: build
  script:
    - make build
  artifacts:
    # .idl/ too: the test stage's make lint checks the IDL rules
    paths: [bin/, .idl/]
    expire_in: 1 day

test:
  stage: test
  cache:
    key: go-$CI_COMMIT_REF_SLUG
    fallback_keys: [go-$CI_DEFAULT_BRANCH]
    paths: [.go/pkg/mod, .go/bin, .go-build]
    policy: pull
  script:
    - make lint
    - make test TESTFLAGS=-count=1
{{- end}}
