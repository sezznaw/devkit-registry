# Generated by devkit (kitex-service@{{.ComponentVersion}}).
MODULE   := {{.Module}}
SERVICE  := {{.Service}}

# Thrift IDLs live in the shared IDL repository. Locally that is the sibling
# checkout in your devkit workspace; CI overrides IDL_DIR after cloning it.
IDL_DIR  ?= ../idl
# Add the IDLs of services you call, e.g. user/user.thrift
IDLS     := $(SERVICE)/$(SERVICE).thrift

KITEX_VERSION    := {{.KitexVersion}}
THRIFTGO_VERSION := {{.ThriftgoVersion}}

.PHONY: tools gen build run test lint docker clean

## tools: install the code generators (once per machine)
tools:
	go install github.com/cloudwego/kitex/tool/cmd/kitex@$(KITEX_VERSION)
	go install github.com/cloudwego/thriftgo@$(THRIFTGO_VERSION)

## gen: generate kitex_gen/ from the IDLs (run after every IDL change)
gen:
	@for f in $(IDLS); do \
		echo ">> kitex $$f"; \
		kitex -module $(MODULE) $(IDL_DIR)/$$f || exit 1; \
	done

build:
	go build -o bin/$(SERVICE) ./cmd/$(SERVICE)

run:
	APP_ENV=$${APP_ENV:-dev} go run ./cmd/$(SERVICE)

test:
	go test ./...

lint:
	go vet ./...

docker:
	docker build -t $(SERVICE):$$(git rev-parse --short HEAD) .

clean:
	rm -rf bin output
