# Run `make gen` before building the image: kitex_gen/ is not in git.
# The Go version is the team's (GoVersion in the template); the official image
# refuses a module that needs a newer Go than it ships.
FROM golang:{{.GoVersion}} AS build
WORKDIR /src
{{- if .GoPrivate}}
ENV GOPRIVATE={{.GoPrivate}}
{{- end}}
COPY go.mod go.sum ./
# For private modules pass a netrc: docker build --secret id=netrc,src=$HOME/.netrc .
RUN --mount=type=secret,id=netrc,target=/root/.netrc,required=false go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/{{.Service}} ./cmd/{{.Service}}
# The image gets the configuration of every environment (dev, uat, prod) except
# local, which is a developer's own machine. One image goes from dev to uat to
# prod; the deployment says where it is with APP_ENV. A container whose APP_ENV
# got emptied would otherwise start with conf/local.yaml: looking for a Nacos on
# 127.0.0.1 and logging colored text that the collector cannot parse. Without
# the file it refuses to start and says which files there are. (The final image
# has no shell, so the selection is made here.)
RUN mkdir -p /out/conf && cp conf/*.yaml /out/conf/ && rm -f /out/conf/local.yaml

FROM gcr.io/distroless/static-debian12
WORKDIR /app
COPY --from=build /out/{{.Service}} /app/{{.Service}}
COPY --from=build /out/conf /app/conf
ENV APP_ENV=prod
# What is logged before the configuration is read, which is the case when it
# cannot be read, has to be JSON for the log collector as well.
ENV ZLOG_FORMAT=json ZLOG_SERVICE={{.Service}} ZLOG_ENV=prod
EXPOSE {{.Port}}
ENTRYPOINT ["/app/{{.Service}}"]
