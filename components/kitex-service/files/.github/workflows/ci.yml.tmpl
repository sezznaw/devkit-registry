{{- if or (eq .CI "github") (eq .CI "both") -}}
# Generated by devkit (kitex-service@{{.ComponentVersion}}).
# kitex_gen/ is not committed: CI checks out the IDL repository and regenerates it.
name: ci
on:
  push:
    branches: [main]
  pull_request:

env:
  IDL_DIR: ${{"{{"}} github.workspace {{"}}"}}/.idl
{{- if .GoPrivate}}
  GOPRIVATE: {{.GoPrivate}}
{{- end}}

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/checkout@v4
        with:
          repository: {{if .IdlRepo}}{{.IdlRepo}}{{else}}${{"{{"}} github.repository_owner {{"}}"}}/idl{{end}}
          path: .idl
{{- if .GoPrivate}}
          # A token that can read the IDL repository (and private Go modules).
          token: ${{"{{"}} secrets.ORG_READ_TOKEN {{"}}"}}
{{- end}}
      - name: IDL at the locked commit (idl.lock)
        run: |
          if [ -f idl.lock ]; then
            SHA=$(cat idl.lock)
            git -C .idl fetch -q --depth 1 origin "$SHA" || { echo "IDL commit $SHA from idl.lock is not on the server: push the idl repository first"; exit 1; }
            git -C .idl checkout -q "$SHA"
          fi
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
{{- if .GoPrivate}}
      - name: git auth for private modules
        run: git config --global url."https://x-access-token:${{"{{"}} secrets.ORG_READ_TOKEN {{"}}"}}@github.com/".insteadOf "https://github.com/"
{{- end}}
      - run: make tools
      - run: make gen
      - run: go mod tidy
      - run: make lint
      - run: make test
      - run: make build
{{- end}}
