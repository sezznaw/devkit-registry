package main

import (
	"fmt"
	"os"

	"{{.CommonModule}}/config"
	"{{.CommonModule}}/kitexx"

	"{{.Module}}/handler"
	"{{.Module}}/kitex_gen/{{.Service | snake}}/{{.Service | title | lower}}service"
