// Command {{.Service}} is the entry point of the {{.Service}} service.
// Generated by devkit (kitex-service@{{.ComponentVersion}}).
//
// THIS FILE BELONGS TO THE FRAMEWORK. `devkit update` replaces it, so do not
// edit it: a change here blocks every later update of this file. Everything
// specific to the service lives in app/app.go (configuration fields,
// dependencies, shutdown cleanup, extra server options) and in handler/.
//
// 本文件属于框架，`devkit update` 会整体替换它，请不要修改：一旦改动，之后这个文件
// 就无法再被升级。服务特有的内容都写在 app/app.go（配置字段、依赖、退出清理、
// 额外的服务端选项）和 handler/ 里。
package main

import (
	"os"

	"{{.CommonModule}}/config"
	"{{.CommonModule}}/kitexx"
	"{{.CommonModule}}/zlog"

	"{{.Module}}/app"
	// Fixed alias: thriftgo renames a service whose name begins with "New"
	// (news -> package newsservice_), and the code below should not care.
	svc "{{.Module}}/kitex_gen/{{.Service | snake}}/{{$pkg}}"
)

func main() {
	// 1. Configuration: conf/<APP_ENV>.yaml, found via $CONF_DIR, ./conf, or next
	//    to the executable, so the start directory does not matter.
	//
	//    A start-up problem is reported through the logger and ends the process
	//    with status 1. Before kitexx.Options the logger is configured by the
	//    environment (the Dockerfile sets ZLOG_FORMAT=json): this is the one line
	//    a log collector must not fail to parse. zlog.Fatal is called where the
	//    problem is, so the record names the step that failed.
	var cfg app.Config
	if err := config.LoadDefault(&cfg); err != nil {
		zlog.Fatal("cannot start", zlog.Err(err))
	}

	// 2. Framework: logging, Nacos registration, request logging, graceful stop.
	opts, err := kitexx.Options(cfg.Config)
	if err != nil {
		zlog.Fatal("cannot start", zlog.Err(err))
	}

	// 3. Service: its dependencies, cleanup and handler (app/app.go).
	h, err := app.Setup(&cfg)
	if err != nil {
		zlog.Fatal("cannot start", zlog.Err(err))
	}
	opts = append(opts, app.ServerOptions(&cfg)...)

	// 4. Serve until SIGINT/SIGTERM, then stop gracefully: leave Nacos, keep
	//    serving briefly, finish requests in progress, run the cleanup.
	svr := svc.NewServer(h, opts...)
	if err := kitexx.Run(svr, cfg.Config); err != nil {
		os.Exit(1)
	}
}
