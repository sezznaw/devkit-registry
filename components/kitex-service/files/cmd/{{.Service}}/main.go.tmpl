// Command {{.Service}} is the entry point of the {{.Service}} service.
// Generated by devkit (kitex-service@{{.ComponentVersion}}).
//
// THIS FILE BELONGS TO THE FRAMEWORK. `devkit update` replaces it, so do not
// edit it: a change here blocks every later update of this file. Everything
// specific to the service lives in app/app.go (configuration fields,
// dependencies, shutdown cleanup, extra server options), app/jobs.go (the
// scheduled jobs), in repo/ (the database code) and in handler/.
//
// 本文件属于框架，`devkit update` 会整体替换它，请不要修改：一旦改动，之后这个文件
// 就无法再被升级。服务特有的内容都写在 app/app.go（配置字段、依赖、退出清理、
// 额外的服务端选项）、app/jobs.go（定时任务）、repo/（数据库代码）和 handler/ 里。
package main

import (
	"os"

	"{{.CommonModule}}/config"
	"{{.CommonModule}}/kitexx"
	"{{.CommonModule}}/zlog"

	"{{.Module}}/app"
	// Fixed alias: thriftgo renames a service whose name begins with "New"
	// (news -> package newsservice_), and the code below should not care.
	svc "{{.Module}}/kitex_gen/{{.Service | snake}}/{{$pkg}}"
)

func main() {
	// 0. Jobs. `--list-jobs` prints the scheduled jobs (app/jobs.go) as JSON
	//    and exits, before any configuration is read: the CI runs it on the
	//    freshly built binary and the deployment makes a CronJob of each.
	//    `--job=<name>` is what that CronJob runs; it is handled after the
	//    framework has opened what the configuration enables.
	jobName, listJobs := kitexx.JobFlags()
	if listJobs {
		os.Exit(kitexx.ListJobs(app.Jobs(&kitexx.Runtime{})))
	}

	// 1. Configuration: conf/<APP_ENV>.yaml, found via $CONF_DIR, ./conf, or next
	//    to the executable, so the start directory does not matter.
	//
	//    A start-up problem is reported through the logger and ends the process
	//    with status 1. Before kitexx.NewRuntime the logger is configured by the
	//    environment (the Dockerfile sets ZLOG_FORMAT=json): this is the one line
	//    a log collector must not fail to parse. zlog.Fatal is called where the
	//    problem is, so the record names the step that failed.
	var cfg app.Config
	if err := config.LoadDefault(&cfg); err != nil {
		zlog.Fatal("cannot start", zlog.Err(err))
	}

	// 2. Framework: logging, tracing, and what the configuration enables
	//    (MySQL with mysql.enabled), opened before the service registers; then
	//    the server options: Nacos registration, request logging, graceful stop.
	rt, err := kitexx.NewRuntime(cfg.Config)
	if err != nil {
		zlog.Fatal("cannot start", zlog.Err(err))
	}
	if err := rt.SetJobs(app.Jobs(rt)); err != nil {
		zlog.Fatal("cannot start", zlog.Err(err))
	}
	if jobName != "" {
		// One job, then exit: no server, no Nacos registration, no consumers.
		os.Exit(rt.RunJob(jobName))
	}
	opts, err := rt.Options()
	if err != nil {
		zlog.Fatal("cannot start", zlog.Err(err))
	}

	// 3. Service: its dependencies, cleanup and handler (app/app.go), given
	//    what the framework opened (rt.DB, ...).
	h, err := app.Setup(&cfg, rt)
	if err != nil {
		zlog.Fatal("cannot start", zlog.Err(err))
	}
	opts = append(opts, app.ServerOptions(&cfg)...)

	// 4. Serve until SIGINT/SIGTERM, then stop gracefully: leave Nacos, keep
	//    serving briefly, finish requests in progress, run the cleanup. With
	//    event subscriptions (rt.Kafka.Subscribe in app.Setup), the consumers
	//    start once the server is up and stop with the cleanup.
	svr := svc.NewServer(h, opts...)
	if err := rt.Run(svr); err != nil {
		os.Exit(1)
	}
}
