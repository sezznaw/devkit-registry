// Package app is where the {{.Service}} service is put together: its
// configuration, its dependencies and what happens to them on shutdown.
//
// This file is yours. devkit created it once and never rewrites it, while
// cmd/{{.Service}}/main.go belongs to the framework and is replaced on every
// `devkit update`. So everything specific to this service goes here (or into
// packages you add), and main.go is never edited.
//
// 本文件归你所有：devkit 只创建一次，之后不会改写。而 cmd/{{.Service}}/main.go 属于
// 框架，每次 `devkit update` 都会被替换。所以本服务特有的一切都写在这里（或你自己
// 新增的包里），不要去修改 main.go。
package app

import (
	"github.com/cloudwego/kitex/server"

	"{{.CommonModule}}/kitexx"

	"{{.Module}}/handler"
	"{{.Module}}/repo"
)

// Config is the whole configuration of the service, loaded from
// conf/<APP_ENV>.yaml. The embedded kitexx.Config is the part the framework
// reads (service, nacos, log, otel, mysql, shutdown; see conf/README.md). Add
// your own sections as fields next to it, together with the matching YAML:
//
//	Redis redisx.Config `yaml:"redis"`
//
//	redis:
//	  addr: "${REDIS_ADDR}"
//
// Config 是本服务的完整配置，从 conf/<APP_ENV>.yaml 加载。内嵌的 kitexx.Config 是
// 框架读取的部分（service、nacos、log、otel、mysql、shutdown，见 conf/README.zh-CN.md）。你自己的配置节
// 作为字段加在它旁边，并在 YAML 里写上对应的内容。
type Config struct {
	kitexx.Config `yaml:",inline"`
}

// Setup is called once at start-up, after the configuration is loaded,
// logging is ready and the framework has opened what the configuration
// enables (rt.DB when mysql.enabled is true), and before the server accepts
// requests. Hand rt to the repo, create what else the service depends on,
// register its cleanup, and return the handler.
//
// MySQL and Redis are not opened here: mysql.enabled / redis.enabled in the
// configuration make the framework open them, and repo.New(rt) takes them.
// What the service opens itself (a client of some other system) registers
// its cleanup with kitexx.OnShutdown, which runs after the server has left
// Nacos and the last request in progress has finished, in reverse order:
//
//	nc, err := natsx.New(cfg.Nats)
//	if err != nil {
//		return nil, err
//	}
//	kitexx.OnShutdown("nats", nc.Close)
//	return handler.New(repo.New(rt), nc), nil
//
// Returning an error stops the start-up with a plain message.
//
// Settings that should change while the service runs come from Nacos:
// kitexx.WatchConfig[Dynamic](cfg.Config) returns a value whose Get() is always
// the version in effect; see "Configuration that follows Nacos" in
// conf/README.md.
//
// Setup 在启动时被调用一次：此时配置已加载、日志已就绪、框架已经打开了配置里启用的东西
// （mysql.enabled 为 true 时 rt.DB 可用），服务尚未开始接收请求。把 rt 交给 repo，
// 创建服务依赖的其他资源、注册它们的清理动作，并返回 handler。用 kitexx.OnShutdown
// 注册的清理会在服务从 Nacos 注销、最后一个处理中的请求结束之后，按相反顺序执行。
// 返回 error 会中止启动，并打印一条明确的错误信息。
// 需要在运行期间调整的配置来自 Nacos：kitexx.WatchConfig[Dynamic](cfg.Config) 返回的值，
// 其 Get() 永远是当前生效的版本；见 conf/README.zh-CN.md 的“跟随 Nacos 的配置”一节。
func Setup(cfg *Config, rt *kitexx.Runtime) (*handler.{{.Service | title}}ServiceImpl, error) {
	h := handler.New(repo.New(rt))
	// Events this service consumes (kafka.enabled), one handler per topic:
	//
	//	rt.Kafka.Subscribe("events.wallet", h.OnWalletEvent)
	//
	// 本服务消费的事件（需要 kafka.enabled），一个主题一个 handler。
	return h, nil
}

// ServerOptions returns extra Kitex server options for this service, applied
// after the framework's own: additional middleware, connection or QPS limits,
// and so on. Return nil when there is nothing to add.
//
//	return []server.Option{server.WithMiddleware(myMiddleware)}
//
// ServerOptions 返回本服务额外的 Kitex 服务端选项，在框架自身的选项之后生效：
// 例如额外的中间件、连接数或 QPS 限制等。没有需要添加的就返回 nil。
func ServerOptions(cfg *Config) []server.Option {
	return nil
}
